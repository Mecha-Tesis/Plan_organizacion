# Copiá este archivo como .env.local para probar en tu compu. En Vercel van en
# Settings > Environment Variables, no en un archivo.

# El "Internal Integration Secret" de la integración de Notion (empieza con ntn_).
NOTION_TOKEN=

# La clave que el equipo usa para tildar. La que quieras; pasala por WhatsApp.
MECHA_CLAVE=
